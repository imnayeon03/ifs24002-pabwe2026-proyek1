# Base URL API backend
VITE_API_URL=http://localhost:4000/api

# Nama aplikasi
VITE_APP_NAME=DelFood

# Autentikasi cookie HttpOnly (true/false). Aktifkan hanya jika back-end sudah mengirim
# cookie sesi (Set-Cookie: HttpOnly; Secure), menyediakan POST /auth/logout, dan mengizinkan
# CORS dengan credentials. Default false: token JWT disimpan di localStorage.
VITE_USE_COOKIE_AUTH=false

# Interval polling (milidetik)
VITE_POLL_INTERVAL=5000
